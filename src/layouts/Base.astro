---
import { getEntry } from 'astro:content';
import '../styles/site.css';
import { url } from '../lib/site';

interface Props { title: string; description?: string; path?: string }
const { title, description, path = '' } = Astro.props;
const about = await getEntry('pages', 'about');
const contactSection = (about?.body ?? '').split(/^## Contact\s*$/m)[1] ?? '';
const contacts = [...contactSection.matchAll(/\[([^\]]+)\]\(([^)]+)\)/g)].map((m) => ({ label: m[1], href: m[2] }));
const nav = [
  { label: 'Projects', href: url('/projects/'), match: '/projects' },
  { label: 'Research', href: url('/research/'), match: '/research' },
  { label: 'How I verify', href: url('/verification/'), match: '/verification' },
  { label: 'Notebook', href: url('/notebook/'), match: '/notebook' },
  { label: 'About', href: url('/about/'), match: '/about' },
];
const fontCss = `@font-face{font-family:"Instrument Sans";font-weight:400 700;font-stretch:75% 100%;font-style:normal;font-display:swap;src:url(${url('/fonts/instrument-sans-latin-wdth-normal.woff2')}) format("woff2")}`
  + [400, 500].map((w) => `@font-face{font-family:"JetBrains Mono";font-weight:${w};font-style:normal;font-display:swap;src:url(${url(`/fonts/jetbrains-mono-latin-${w}-normal.woff2`)}) format("woff2")}`).join('')
  // marker lettering on the CPU lab's tape labels only; downloaded only on pages that use it
  + `@font-face{font-family:"Permanent Marker";font-weight:400;font-style:normal;font-display:swap;src:url(${url('/fonts/permanent-marker-latin-400-normal.woff2')}) format("woff2")}`;
const rel = Astro.url.pathname.slice(url('/').length - 1);
const fullTitle = title === 'Brandon Treglown' ? title : `${title} | Brandon Treglown`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="data:," />
    <link rel="preload" href={url('/fonts/instrument-sans-latin-wdth-normal.woff2')} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontCss}></style>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <div class="g">
        <a class="name" href={url('/')}>Brandon Treglown</a>
        <nav aria-label="Main">
          {nav.map((n) => (
            <a href={n.href} aria-current={rel.startsWith(n.match) ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main id="main" class="g"><slot /></main>
    <footer class="foot">
      <div class="g foot-in">
        <div class="foot-id">
          <a class="foot-name" href={url('/')}>Brandon Treglown</a>
          <p class="foot-tag">Systems engineering, test infrastructure and verification.</p>
        </div>
        <nav class="foot-cols" aria-label="Footer">
          <div><p class="foot-h">Work</p><a href={url('/projects/')}>Projects</a><a href={url('/projects/8-bit-pipelined-cpu/')}>CPU lab</a><a href={url('/research/')}>Research library</a></div>
          <div><p class="foot-h">Method</p><a href={url('/verification/')}>How I verify</a><a href={url('/notebook/')}>Notebook</a><a href={url('/about/')}>About</a></div>
          <div><p class="foot-h">Contact</p>{contacts.map((c) => <a href={c.href}>{c.label}</a>)}</div>
        </nav>
      </div>
    </footer>
  </body>
</html>
